{
  "name": "foreman-mvp",
  "version": "0.0.0",
  "private": true,
  "description": "Foreman MVP: compare a lead+workers Pi harness against solo models on the same task, graded by hidden tests.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./foreman/orchestrate.ts",
      "./node_modules/@mjakl/pi-subagent",
      "./foreman/prompt.ts"
    ]
  },
  "dependencies": {
    "@mjakl/pi-subagent": "3.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "compare": "tsx scripts/compare.ts",
    "report": "tsx scripts/report.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "selftest": "tsx scripts/selftest/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
