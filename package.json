{
  "name": "pi-foreman",
  "version": "0.1.0",
  "private": true,
  "description": "Foreman for Pi: a strong lead model plans and delegates to cheaper worker models (/orchestrate, --orchestrate, /team), plus paste-to-save OpenRouter keys.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./foreman/orchestrate.ts",
      "./node_modules/@mjakl/pi-subagent",
      "./foreman/prompt.ts",
      "./foreman/keys.ts"
    ]
  },
  "dependencies": {
    "@mjakl/pi-subagent": "3.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs --types-only"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
