pi-config/*/sessions/
pi-config/*/npm/
pi-config/*/git/
pi-config/*/bin/
pi-config/*/tools/
pi-config/*/tmp/

# saved FreeLLMAPI connection (contains an API key), written by /login-with-freellm
pi-config/*/freellmapi.json

# worker definitions the foreman package copies in at startup (source of truth: foreman/agents/)
pi-config/*/agents/
